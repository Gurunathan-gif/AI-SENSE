{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Launch Backend Server (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Launch Frontend in Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "🔥 Full Stack Debug (Backend + Frontend)",
      "configurations": ["🚀 Launch Backend Server (Node.js)", "🌐 Launch Frontend in Chrome"]
    }
  ]
}
